# Required. Developer Portal > Application > Bot > Token
DISCORD_TOKEN=
# Optional development guild copy; global commands are always registered
DEV_GUILD_ID=
# Optional comma-separated bot operator IDs for /developer
DEV_USER_IDS=
# Optional SQLite path; default data/bot.sqlite
DATABASE_PATH=data/bot.sqlite
# Optional welcome events: also enable Server Members Intent in Developer Portal
ENABLE_MEMBER_EVENTS=false
# Optional local Ogg Opus playback; adds Guild Voice States intent
ENABLE_AUDIO=false
AUDIO_DIRECTORY=media
