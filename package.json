{
  "name": "archnemesis-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted modular Discord bot with guild-isolated SQLite persistence.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node dist/bot.js",
    "dev": "tsx watch src/bot.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "list": "tsx scripts/list.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "reference": "tsx scripts/reference.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  },
  "license": "AGPL-3.0-only"
}
